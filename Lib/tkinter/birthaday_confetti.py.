import tkinter as tk
import random

# Create window
root = tk.Tk()
root.title("Happy Birthday!")
root.geometry("600x400")
root.configure(bg="black")

# Birthday message
message = tk.Label(root, text="🎉 Happy Birthday! 🎂", font=("Arial", 24, "bold"), fg="yellow", bg="black")
message.pack(pady=50)

# Function to create confetti
def create_confetti():
    for _ in range(50):
        x, y = random.randint(0, 600), random.randint(0, 400)
        color = random.choice(["red", "blue", "green", "yellow", "pink", "purple"])
        confetti = tk.Label(root, text="★", fg=color, bg="black", font=("Arial", 14))
        confetti.place(x=x, y=y)

# Button to start animation
start_button = tk.Button(root, text="Celebrate! 🎊", command=create_confetti, font=("Arial", 14), bg="gold", fg="black")
start_button.pack(pady=20)

# Run the Tkinter loop
root.mainloop()
